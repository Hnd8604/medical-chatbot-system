FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_REQUEST_TIMEOUT_SECONDS=20
APP_NAME=Dịch vụ Chatbot Y tế
# Múi giờ để hiểu "hôm nay", "tháng trước", "3 tháng qua" trong câu hỏi.
APP_TIMEZONE=Asia/Ho_Chi_Minh

LLM_PROVIDER=openai
# Model của bước sinh câu trả lời, chọn theo plan: nhiều step / giải thích / nhiều bệnh
# nhân -> MODEL_COMPLEX; còn lại -> MODEL_SIMPLE; quota > 80% -> luôn MODEL_SIMPLE.
MODEL_SIMPLE=gpt-4o-mini
MODEL_COMPLEX=gpt-4.1-mini
LLM_REQUEST_TIMEOUT_SECONDS=20
ENABLE_LLM_ANSWER=true

# AI Gateway (LiteLLM, không trạng thái). Đường LLM duy nhất; bật khi có LITELLM_MASTER_KEY.
# Hạn mức theo user do Spring chặn trước mỗi lượt chat; gateway chỉ chuyển tiếp + báo cost.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev

# Rolling summary hội thoại (qua LiteLLM gateway).
# Chỉ gọi LLM khi tổng số message của session >= SUMMARY_TRIGGER_MESSAGE_COUNT.
ENABLE_LLM_SUMMARY=true
MODEL_SUMMARY=gpt-4o-mini
SUMMARY_TRIGGER_MESSAGE_COUNT=8

# Terminology enrichment: giải thích mã y khoa (chỉ chạy khi câu hỏi mang ý "giải thích").
# RxNorm + MedlinePlus là API công khai (không cần key). LOINC cần tài khoản loinc.org
# miễn phí; thiếu LOINC_USERNAME/PASSWORD -> nhánh LOINC tự bỏ qua, 2 nguồn kia vẫn chạy.
LOINC_ENABLED=true
RXNORM_ENABLED=true
MEDLINEPLUS_ENABLED=true
LOINC_USERNAME=
LOINC_PASSWORD=
TERMINOLOGY_TIMEOUT_SECONDS=5

# ---- Agent: router -> planner -> validator -> executor -> answer ----
# Model theo stage. Bỏ trống -> router/chat dùng MODEL_SIMPLE, planner dùng MODEL_COMPLEX.
MODEL_ROUTE=
MODEL_PLANNER=
MODEL_CHAT=

# Số quyết định route được nhớ trong LRU của tiến trình (0 = tắt).
ROUTE_CACHE_SIZE=512
# Trần số step của một plan sau khi validate.
MAX_PLAN_STEPS=4
# Evidence budget: trần ký tự evidence đưa vào prompt answer (~4 ký tự/token).
EVIDENCE_MAX_CHARS=12000
# Fast-path: plan 1 bước + data_only + ít evidence -> dùng câu template, không gọi answer LLM.
TEMPLATE_FAST_PATH=false
TEMPLATE_FAST_PATH_MAX_EVIDENCE=5
# Quota đã dùng >= ngưỡng -> lượt phức tạp cũng chỉ dùng MODEL_SIMPLE cho answer.
QUOTA_DOWNGRADE_RATIO=0.8
# Low-cost mode: quota >= ngưỡng -> router/planner bằng luật, nhánh chat dùng template,
# bỏ terminology, ép template fast-path, summary thưa hơn, evidence budget nhỏ hơn.
LOW_COST_MODE_RATIO=0.9
LOW_COST_EVIDENCE_MAX_CHARS=6000
# Rolling summary theo mốc Spring gửi: tóm tắt khi số tin chưa tóm tắt đạt ngưỡng.
SUMMARY_MIN_NEW_MESSAGES=2
LOW_COST_SUMMARY_MIN_NEW_MESSAGES=8
# Grounding check câu trả lời LLM (mã bệnh nhân/resource, ngày, con số phải có trong evidence).
# enforce = sai thì thay bằng câu template và không cache; log = chỉ ghi log; off = tắt.
GROUNDING_CHECK_MODE=enforce

# Plan cache: cache "ý định đã validate" (không chứa PHI), dùng chung mọi user, TTL dài.
ENABLE_PLAN_CACHE=true
PLAN_CACHE_COLLECTION_NAME=medical_plan_cache
PLAN_CACHE_TTL_SECONDS=86400
# Hiệu chỉnh bằng: python -m tests.eval.run_cache_pairs (xem docs/agent.md mục 5.2).
PLAN_CACHE_SIMILARITY_THRESHOLD=0.92

# QUYẾT ĐỊNH BẢO MẬT ĐANG CHỜ CHỐT.
# false = USER không được get_resource_by_id.
# true  = cho phép, executor kiểm tra chủ sở hữu resource sau khi fetch.
ALLOW_USER_RESOURCE_LOOKUP=false

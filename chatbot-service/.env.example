FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_REQUEST_TIMEOUT_SECONDS=20
APP_NAME=Dịch vụ Chatbot Y tế

LLM_PROVIDER=openai
MODEL_SIMPLE=gpt-4o-mini
MODEL_COMPLEX=gpt-4.1-mini
LLM_REQUEST_TIMEOUT_SECONDS=20
ENABLE_LLM_ANSWER=true

# LLM Router (M16): model rẻ phân loại SIMPLE/COMPLEX thay cho keyword thuần.
# Tắt (false) → chỉ dùng keyword classifier như trước.
ENABLE_LLM_ROUTER=false
MODEL_ROUTER=gpt-4o-mini

# AI Gateway (LiteLLM). Đường LLM duy nhất; bật khi có LITELLM_MASTER_KEY.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev

# Rolling summary hội thoại (qua LiteLLM gateway).
# Chỉ gọi LLM khi tổng số message của session >= SUMMARY_TRIGGER_MESSAGE_COUNT.
ENABLE_LLM_SUMMARY=true
MODEL_SUMMARY=gpt-4o-mini
SUMMARY_TRIGGER_MESSAGE_COUNT=8

# Terminology enrichment: giải thích mã y khoa (chỉ chạy khi câu hỏi mang ý "giải thích").
# RxNorm + MedlinePlus là API công khai (không cần key). LOINC cần tài khoản loinc.org
# miễn phí; thiếu LOINC_USERNAME/PASSWORD -> nhánh LOINC tự bỏ qua, 2 nguồn kia vẫn chạy.
LOINC_ENABLED=true
RXNORM_ENABLED=true
MEDLINEPLUS_ENABLED=true
LOINC_USERNAME=
LOINC_PASSWORD=
TERMINOLOGY_TIMEOUT_SECONDS=5

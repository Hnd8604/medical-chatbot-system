OPENAI_API_KEY=replace_me
GROQ_API_KEY=
LITELLM_MASTER_KEY=sk-local-dev

# DB-backed gateway (virtual keys, per-key budget, spend logs, Admin UI /ui).
# Tro toi database `litellm` tren instance app-postgres (host cong 5433).
DATABASE_URL=postgresql://app_user:app_password@host.docker.internal:5433/litellm
# Bat buoc. Ma hoa virtual key khi luu DB. KHONG doi sau khi da sinh key.
LITELLM_SALT_KEY=sk-salt-local-dev
# Dang nhap Admin UI tai http://localhost:4000/ui
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=admin

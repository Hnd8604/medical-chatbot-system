                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Send chat message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.session_id) pm.collectionVariables.set('sessionId', res.session_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": null,\n  \"patient_id\": \"{{patientId}}\",\n  \"message\": \"huyet ap cua benh nhan nay the nao?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat"
              ]
            }
          }
        },
        {
          "name": "List chat sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "sessions"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Get session messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions/{{sessionId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "sessions",
                "{{sessionId}}",
                "messages"
              ]
            }
          }
        },
        {
          "name": "Submit message feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Cau tra loi huu ich\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/chat/messages/{{messageId}}/feedback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "messages",
                "{{messageId}}",
                "feedback"
              ]
            }
          }
        },
        {
          "name": "Export single session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chat/sessions/{{sessionId}}/export?format=pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "sessions",
                "{{sessionId}}",
                "export"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "pdf",
                  "description": "pdf hoặc csv"
                }
              ]
            }
          }
        },
        {
          "name": "Export sessions by date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/chat/export?from=2026-06-01&to=2026-06-28&format=pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat",
                "export"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-06-01"
                },
                {
                  "key": "to",
                  "value": "2026-06-28"
                },
                {
                  "key": "format",
                  "value": "pdf",
                  "description": "pdf hoặc csv"
                }
              ]
            }
          }
        }

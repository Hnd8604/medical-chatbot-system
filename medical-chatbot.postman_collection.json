{
  "info": {
    "name": "Medical Chatbot API (Spring Backend 8081)",
    "description": "Postman collection cho Spring Boot backend của Medical Chatbot.\n\nCách dùng:\n1. Import file này vào Postman.\n2. Chọn collection -> tab Variables, đặt baseUrl (mặc định http://localhost:8081).\n3. Chạy Auth -> Login. Test script tự lưu JWT vào biến `token`.\n4. Các request khác tự gắn Bearer token qua collection auth.\n\nPhân quyền: /api/admin/** + audit-logs/metrics cần ADMIN; /api/patients/** cần DOCTOR hoặc ADMIN; chat/quota/cost/notification cần đăng nhập.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "demo-patient-001",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "username",
      "value": "demo_user",
      "type": "string"
    },
    {
      "key": "quotaPolicyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "modelPricingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "alertId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],

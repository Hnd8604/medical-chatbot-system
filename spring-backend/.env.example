# Development profile (application-dev.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/medical_chatbot_app
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=app_password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

CHATBOT_SERVICE_BASE_URL=http://localhost:8000
CHATBOT_SERVICE_CONNECT_TIMEOUT=3s
CHATBOT_SERVICE_READ_TIMEOUT=120s
SERVER_PORT=8081

LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-dev
LITELLM_GATEWAY_ENABLED=true

# At least 32 characters. Never reuse this development value in production.
JWT_SECRET=change_this_development_jwt_secret_to_a_long_random_value
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_MINUTES=10080

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BACKUP_ENABLED=true
BACKUP_UPLOAD=false
RCLONE_REMOTE=gdrive
RCLONE_DEST=medical-chatbot-backups

# Leave host empty in development to use the OTP logging fallback.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TICKET_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/medical_chatbot_app
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=app_password
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
CHATBOT_SERVICE_BASE_URL=http://localhost:8000
SERVER_PORT=8081

JWT_SECRET=change_this_development_jwt_secret_to_a_long_random_value
JWT_EXPIRATION_MINUTES=480

TELEGRAM_BOT_TOKEN=your_token
TELEGRAM_CHAT_ID=your_chat_id

# SMTP cho email quên mật khẩu. Bỏ trống SPRING_MAIL_HOST => dev fallback: mã OTP chỉ log ra console.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your_email@gmail.com
# SPRING_MAIL_PASSWORD=your_app_password
# PASSWORD_RESET_OTP_TTL_MINUTES=10
# PASSWORD_RESET_TICKET_TTL_MINUTES=10
# PASSWORD_RESET_MAX_ATTEMPTS=5
# PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_FROM_ADDRESS=no-reply@medical-chatbot.local
# PASSWORD_RESET_FROM_NAME=Medical Chatbot

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/medical_chatbot_app
SPRING_DATASOURCE_USERNAME=medical_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-password

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace-with-a-strong-password

CHATBOT_SERVICE_BASE_URL=http://chatbot-service:8000
CHATBOT_SERVICE_CONNECT_TIMEOUT=3s
CHATBOT_SERVICE_READ_TIMEOUT=120s

# Generate a random secret of at least 32 characters; do not use the example value.
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_MINUTES=10080

# Comma-separated HTTPS origins. Do not include localhost in production.
APP_CORS_ALLOWED_ORIGINS=https://medical.example.com
SPRINGDOC_ENABLED=false

LITELLM_BASE_URL=http://litellm:4000
LITELLM_GATEWAY_ENABLED=false
LITELLM_MASTER_KEY=

# Backup scripts are not copied into the backend image. Mount them before enabling.
BACKUP_ENABLED=false

SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-me
SPRING_MAIL_PASSWORD=replace-me
PASSWORD_RESET_FROM_ADDRESS=no-reply@medical.example.com
PASSWORD_RESET_FROM_NAME=Medical Chatbot

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
